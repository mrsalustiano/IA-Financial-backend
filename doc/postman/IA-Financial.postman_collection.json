            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Banco Principal Editado\",\n  \"description\": \"Conta editada via Postman\",\n  \"type\": \"CONTA_CORRENTE\",\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountId}}"]
            },
            "description": "Alteração com auditoria (oldValue/newValue) e atualização de updatedAt."
          },
          "response": []
