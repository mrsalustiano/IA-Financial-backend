    {
      "name": "1. Contas",
      "item": [
        {
          "name": "Criar conta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Conta criada (201)', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Envelope presente', () => { pm.expect(json.message).to.eql('Success'); pm.expect(json.data.id).to.exist; });",
                  "pm.collectionVariables.set('accountId', json.data.id);",
                  "console.log('accountId salvo:', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Banco Principal\",\n  \"description\": \"Conta corrente principal\",\n  \"type\": \"CONTA_CORRENTE\",\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            },
            "description": "Cria uma conta. Tipos válidos: CONTA_CORRENTE, POUPANCA, CARTAO_CREDITO, DINHEIRO, INVESTIMENTO. Nome duplicado (case-insensitive) retorna 409."
          },
          "response": []
        },
        {
          "name": "Listar contas (filtros + paginação)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts?type=CONTA_CORRENTE&active=true&page=0&size=20&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"],
              "query": [
                { "key": "type", "value": "CONTA_CORRENTE" },
                { "key": "active", "value": "true" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "name,asc" }
              ]
            },
            "description": "Listagem com filtro por tipo/situação, paginação e ordenação (ex.: name,desc)."
          },
          "response": []
        },
        {
          "name": "Buscar conta por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountId}}"]
            },
            "description": "Retorna 404 se a conta não existe ou foi excluída logicamente."
          },
          "response": []
        },
        {
          "name": "Alterar conta",
          "event": [
            {
              "listen": "test",
